# Copy to .env and fill in the key for whichever provider you are testing.
# .env is gitignored.
#
# These are deliberately NOT prefixed with VITE_. The dev server reads them in
# Node and attaches them to proxied requests, so they never reach the browser
# bundle. A VITE_ prefix would inline them into client code.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which adapter the example uses: openai (default) or claude.
VITE_PROVIDER=openai
